<?xml version="1.0" encoding="UTF-8"?>
<interface domain="com.vinii.system_ui">
    <requires lib="gtk" version="4.20"/>

    <object class="GtkAdjustment" id="scale-adjustment">
        <property name="lower">0.0</property>
        <property name="upper">100.0</property>
        <property name="step-increment">1.0</property>
        <property name="page-increment">10.0</property>
        <property name="value">50.0</property>
    </object>

    <object class="GtkApplicationWindow" id="main-window">
        <child> 
        <object class="GtkGrid" id="main-grid">

            <child> 
            <object class="GtkScale" id="brightness-scale">
                <property name="adjustment">scale-adjustment</property>
                <layout>
                    <property name="column">0</property>
                    <property name="row">0</property>
                    <property name="column-span">4</property>
                    <property name="row-span">1</property>
                </layout>
            </object>
            </child>

            <child>
            <object class="GtkButton">
                <property name="label">botao</property>
                <layout>
                    <property name="column">0</property>
                    <property name="row">1</property>
                    <property name="column-span">1</property>
                    <property name="row-span">1</property>
                </layout>
            </object>
            </child>

        </object>
        </child>
    </object>
</interface>
